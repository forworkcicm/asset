function downloadCsv() {
  const list = filtered(); if (!list.length) { toast('ไม่มีข้อมูลให้ดาวน์โหลด'); return; }
  const out = [S.headers, ...list.map(j => S.headers.map((_, i) => j.cells[i] ?? ''))].map(r => r.map(csvCell).join(',')).join('\r\n');
  const d = new Date(), stamp = `${d.getFullYear()}${String(d.getMonth() + 1).padStart(2, '0')}${String(d.getDate()).padStart(2, '0')}`;
  const a = document.createElement('a');
  a.href = URL.createObjectURL(new Blob(['﻿' + out], {type:'text/csv;charset=utf-8'}));
  a.download = `cicm-repair-registry_${stamp}.csv`; document.body.appendChild(a); a.click(); a.remove();   // ชื่อไฟล์ภาษาอังกฤษ กันบางเบราว์เซอร์ตัดชื่อไทยทิ้ง
  setTimeout(() => URL.revokeObjectURL(a.href), 2000); toast(`ดาวน์โหลด ${list.length} งานแล้ว`);
}

/* ============================================================ โหลดข้อมูล */
async function load(manual = false) {
  if (S.busy) return; S.busy = true;
  const rb = $('#refreshBtn'); rb.disabled = true; rb.querySelector('svg').classList.add('spin');
  try {
    const {src, text} = await loadAny();
    // รีเฟรชอัตโนมัติ: ถ้าเคยได้ข้อมูลสดแล้ว แต่รอบนี้ตกไปใช้ข้อมูลสำรอง ให้คงข้อมูลสดเดิมไว้
    if (S.src && S.src.state === 'live' && src.state === 'backup') { S.stale = true; renderSource(); if (manual) toast('ดึงข้อมูลสดไม่สำเร็จ ใช้ข้อมูลล่าสุดที่มี'); }
    else {
      const table = parseCsv(text), built = buildJobs(table);
      Object.assign(S, {headers:built.headers, map:built.map, jobs:built.jobs, src, at:new Date(), err:null, stale:false});
      fillFilters(); renderAll();
      if (manual) toast(`อัปเดตแล้ว · ${built.jobs.length} งาน`);
    }
  } catch (e) {
    if (S.jobs.length) { S.stale = true; renderSource(); if (manual) toast('รีเฟรชไม่สำเร็จ'); }
    else { S.err = e; renderError(e); }
  } finally { S.busy = false; rb.disabled = false; rb.querySelector('svg').classList.remove('spin'); }
}

/* ============================================================ ฮีโร่: ยืดตัวอักษรยักษ์ให้เต็มความสูง */
function fitGiant() {
  const g = $('#giant'), h = $('.hero'); g.style.transform = 'none';
  const cur = g.offsetHeight || 1; g.style.transform = `scale(1.15, ${(h.clientHeight * 0.92) / cur})`;
}

/* ============================================================ ผูกเหตุการณ์ */
function bind() {
  hydrateIcons(document);
  $('#fQ').addEventListener('input', e => { S.f.q = e.target.value; renderAll(); });
  [['fFy','fy'],['fKind','kind'],['fStatus','status'],['fVendor','vendor']].forEach(([id, k]) => $('#'+id).addEventListener('change', e => { S.f[k] = e.target.value; renderAll(); }));
  $('#clearBtn').addEventListener('click', () => { S.f = {q:'', fy:'', kind:'', status:'', vendor:''}; fillFilters(); S.f.fy = ''; $('#fFy').value = ''; renderAll(); });
  $('#refreshBtn').addEventListener('click', () => load(true));
  $('#csvBtn').addEventListener('click', downloadCsv);
  $('#menuBtn').addEventListener('click', openMenu);
  $('#menuClose').addEventListener('click', closeMenu);
  $('#scrim').addEventListener('click', () => { closeMenu(); if ($('#panel').classList.contains('on')) closeDetail(); });
  document.addEventListener('keydown', e => { if (e.key === 'Escape') { if ($('#panel').classList.contains('on')) closeDetail(); closeMenu(); } });
  $('#menu').addEventListener('click', e => {
    const a = e.target.closest('[data-close],[data-act]'); if (!a) return;
    closeMenu();
    if (a.dataset.act === 'refresh') load(true); else if (a.dataset.act === 'csv') downloadCsv();
  });
  document.addEventListener('click', e => {
    const o = e.target.closest('[data-open]'); if (o) { openDetail(+o.dataset.open); return; }
    const s = e.target.closest('[data-sort]'); if (s) { const k = s.dataset.sort; S.sort = {key:k, dir: S.sort.key === k ? -S.sort.dir : (k === 'title' ? 1 : -1)}; renderTable(filtered()); return; }
    const c = e.target.closest('[data-copy]'); if (c) { copyText(c.dataset.copy); return; }
    if (e.target.closest('#panelClose')) { closeDetail(); return; }
    if (e.target.closest('#toggleEmpty')) { S.showEmpty = !S.showEmpty; const y = $('#panel').scrollTop; openDetail(S.open); $('#panel').scrollTop = y; }
  });
  const nav = $('#nav'), onScroll = () => nav.classList.toggle('scrolled', scrollY > $('.hero').clientHeight - 90);
  addEventListener('scroll', onScroll, {passive:true}); onScroll();
  addEventListener('resize', fitGiant); (document.fonts?.ready || Promise.resolve()).then(fitGiant); fitGiant();
  if (CFG.refreshSec > 0) setInterval(() => { if (!document.hidden) load(false); }, CFG.refreshSec * 1000);
}

bind(); load(false);
})();
</script>
