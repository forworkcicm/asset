  seq:j => j.seqN ?? -1, sign:j => j.refDate?.getTime() ?? 0, title:j => j.raw.title, amt:j => j.amt ?? -1,
  egp:j => j.raw.egp, po:j => j.dt.po_date.d?.getTime() ?? 0, due:j => j.dt.due.d?.getTime() ?? 0, done:j => j.done
