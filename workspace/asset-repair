// คืน {raw, d, bad}; bad = มีค่าแต่ไม่ใช่วันที่ที่เป็นไปได้ (เช่น 31/12/1899 ที่เกิดจากช่องว่างถูกคำนวณ)
function parseDate(raw) {
  const s = String(raw || '').trim();
  if (!s) return {raw:'', d:null, bad:false};
  let y, m, d, t;
  if ((t = s.match(/^(\d{1,2})\/(\d{1,2})\/(\d{4})/))) { d = +t[1]; m = +t[2]; y = +t[3]; }
  else if ((t = s.match(/^(\d{4})-(\d{1,2})-(\d{1,2})/))) { y = +t[1]; m = +t[2]; d = +t[3]; }
  else return {raw:s, d:null, bad:true};
  if (y > 2400) y -= 543;                               // พ.ศ. → ค.ศ.
  const dt = new Date(y, m - 1, d);
  const ok = dt.getFullYear() === y && dt.getMonth() === m - 1 && dt.getDate() === d && y >= 2000 && y <= 2100;
  return ok ? {raw:s, d:dt, bad:false} : {raw:s, d:null, bad:true};
}

/* ============================================================ CSV */
function parseCsv(text) {
  text = text.replace(/^﻿/, '');
  const rows = []; let row = [], cell = '', q = false;
  for (let i = 0; i < text.length; i++) {
    const c = text[i];
    if (q) {
      if (c === '"') { if (text[i+1] === '"') { cell += '"'; i++; } else q = false; }
      else cell += c;
    } else if (c === '"') q = true;
    else if (c === ',') { row.push(cell); cell = ''; }
    else if (c === '\n' || c === '\r') { if (c === '\r' && text[i+1] === '\n') i++; row.push(cell); rows.push(row); row = []; cell = ''; }
    else cell += c;
  }
  if (cell !== '' || row.length) { row.push(cell); rows.push(row); }
  return rows;
}
