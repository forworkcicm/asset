  for (const s of SOURCES()) {
    try { const text = await fetchText(s.url); return {src:s, text, log}; }
    catch (e) { log.push(`${s.label}: ${e.name === 'AbortError' ? 'หมดเวลา' : e.message}`); }
  }
  const err = new Error('ดึงข้อมูลไม่ได้จากทุกแหล่ง'); err.log = log; throw err;
}

/* ============================================================ แปลงตาราง → งาน */
function matchHeaders(headers) {
  const hn = headers.map(norm), map = {}, used = new Set();
  FIELDS.forEach(f => { const i = hn.indexOf(norm(f.h)); if (i >= 0 && !used.has(i)) { map[f.k] = i; used.add(i); } });
  FIELDS.forEach(f => {
    if (map[f.k] != null) return;
    const fn = norm(f.h);
    const i = hn.findIndex((h, j) => !used.has(j) && h.length >= 6 && (h.startsWith(fn) || fn.startsWith(h)));
    if (i >= 0) { map[f.k] = i; used.add(i); }
  });
  return map;
}
function fiscalYear(d) { return d ? d.getFullYear() + (d.getMonth() >= 9 ? 1 : 0) + 543 : null; }

function buildJobs(table) {
  const headers = table[0].map(h => h.trim());
  const map = matchHeaders(headers);
  const jobs = [];
  for (let r = 1; r < table.length; r++) {
    const cells = table[r];
    if (!cells.some(c => String(c).trim())) continue;
    const raw = {};
    FIELDS.forEach(f => raw[f.k] = map[f.k] != null ? String(cells[map[f.k]] ?? '').replace(/ /g, ' ').trim() : '');
    if (!raw.title && !raw.seq && !raw.amount) continue;
    const dt = {}; DATE_KEYS.forEach(k => dt[k] = parseDate(raw[k]));
    const mo = {}; MONEY_KEYS.forEach(k => mo[k] = parseMoney(raw[k]));
    const j = {id:jobs.length, raw, cells, dt, mo, seqN:parseInt(raw.seq, 10)};
    j.amt = mo.agreed ?? mo.amount ?? mo.central ?? mo.offer;
    const ref = dt.sign_date.d || dt.rep_date.d || dt.po_date.d;
    j.fy = fiscalYear(ref); j.refDate = ref;
    const filled = k => DATE_KEYS.includes(k) ? !!dt[k].d : MONEY_KEYS.includes(k) ? mo[k] != null : !!raw[k];
    j.stages = STAGES.map(s => {
      const miss = s.req.filter(k => !filled(k));
      return {...s, st: miss.length === 0 ? 'done' : miss.length === s.req.length ? 'none' : 'part', miss};
    });
    j.done = j.stages.filter(s => s.st === 'done').length;
    j.warns = [];
    DATE_KEYS.forEach(k => { if (dt[k].bad) j.warns.push(`วันที่ผิดปกติ: ${label(k)} (${dt[k].raw}) — มักเกิดจากช่องวันที่ว่างแล้วถูกนำไปคำนวณ`); });
    const vals = MONEY_KEYS.map(k => mo[k]).filter(v => v != null);
    if (new Set(vals.map(v => v.toFixed(2))).size > 1) j.warns.push('ยอดเงินในแต่ละช่องไม่เท่ากัน (จำนวนเงิน / ราคากลาง / ราคาที่เสนอ / ราคาที่ตกลง)');
    if (dt.po_date.d && dt.due.d && dt.due.d < dt.po_date.d) j.warns.push('ครบกำหนดส่งมอบ อยู่ก่อนวันที่ใบสั่ง');
    j.hay = Object.values(raw).join(' ').toLowerCase();
    jobs.push(j);
  }
  return {headers, map, jobs};
}
const label = k => FIELDS.find(f => f.k === k)?.h || k;

/* ============================================================ สถานะแอป */
const S = {headers:[], map:{}, jobs:[], src:null, at:null, err:null,
